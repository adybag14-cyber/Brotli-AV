<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bav-csharp</AssemblyName>
    <RootNamespace>Bav</RootNamespace>
    <Optimize>true</Optimize>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <!-- Zstd level 22; Brotli is built into .NET; LZMA/XZ via XZ.NET -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.5" />
    <PackageReference Include="XZ.NET" Version="2.0.0" />
  </ItemGroup>
</Project>
